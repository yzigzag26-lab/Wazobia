# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT CONFIG — COMMITTED ON PURPOSE
# -----------------------------------------------------------------------------
# Vite loads `.env.development` in dev mode automatically, before `.env`.
#
# Why this file is tracked when `.env` is not:
#   `.env` is gitignored, so it is not part of the repository and does not
#   survive a fresh checkout, a new branch, or a container rebuild. Sign-in
#   then fails with "Sign-in is not configured for this build" — which reads
#   like an auth bug but is simply missing configuration. That happened
#   repeatedly, so the development defaults live in a file that travels with
#   the code.
#
# Why committing these two values is safe:
#   Both are PUBLIC by design. `VITE_SUPABASE_URL` is a project address, and
#   the anon key is the credential Supabase hands to browsers — it ships inside
#   the JavaScript bundle either way, and its power is bounded by Row Level
#   Security. The service-role key is NOT here and must never be.
#
# Production does not read this file. Vercel supplies the same names through
# its own environment settings; see docs/operations/DEPLOYMENT.md.

VITE_SUPABASE_URL=https://bxifjhhgmomiacehngyj.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ4aWZqaGhnbW9taWFjZWhuZ3lqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkyNDI4NzIsImV4cCI6MjEwNDgxODg3Mn0.DL9625gL9d3gKOhYBeIlkaWCiUMpUr6glFjMaOaiWw0

# Empty: the browser calls /api/v1/* on its own origin. Set this only when a
# separate backend is running locally and the dev proxy should forward to it.
VITE_API_ORIGIN=

VITE_APP_VERSION=0.1.0-dev
