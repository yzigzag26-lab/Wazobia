# Dependencies
node_modules/
.pnp
.pnp.*

# Build output — regenerated by `npm run build` / `npm run preview`
dist/
dist-ssr/
*.local

# Test and tooling caches
coverage/
.vite/
.vitest/
*.tsbuildinfo

# Environment.
#
# `.env` stays local and is never committed. Server-side keys (service_role,
# provider API keys) must never be committed under any name.
#
# `.env.development` IS committed, deliberately. It holds only the two PUBLIC
# Supabase values: a project URL and the anon key, which ships inside the
# browser bundle by design and is bounded by Row Level Security. Keeping them
# in a tracked file is what stops a fresh checkout or a rebuilt container from
# starting with sign-in silently unconfigured — a failure that reads as an auth
# bug and cost several debugging rounds.
.env
.env.local
.env.*.local
!.env.example
!.env.development

# Editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel
.vercel

# Playwright was installed ad-hoc in earlier phases (`--no-save`).
# If it becomes a saved dependency, delete these two lines.
test-results/
playwright-report/

# Generated import output — 1.4 MB of SQL, regenerated by
# `node supabase/import/igbo-api.mjs`. The importer and its docs are committed;
# the generated dump is not, following the repo's "keep artifacts out of Git" rule.
supabase/import/out/
