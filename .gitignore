# Dependencies
node_modules/
.pnp
.pnp.*

# Build output — regenerated by `npm run build` / `npm run preview`
dist/
dist-ssr/
*.local

# Test and tooling caches
coverage/
.vite/
.vitest/
*.tsbuildinfo

# Environment — only `.env.example` is committed.
# Public VITE_* values are still secrets-by-convention: they belong in the
# deployment dashboard, not in Git. Server-side keys must never be committed.
.env
.env.*
!.env.example

# Editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel
.vercel

# Playwright was installed ad-hoc in earlier phases (`--no-save`).
# If it becomes a saved dependency, delete these two lines.
test-results/
playwright-report/

# Generated import output — 1.4 MB of SQL, regenerated by
# `node supabase/import/igbo-api.mjs`. The importer and its docs are committed;
# the generated dump is not, following the repo's "keep artifacts out of Git" rule.
supabase/import/out/
