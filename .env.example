# =============================================================================
# WAZOBIA environment configuration
# =============================================================================
# Copy to `.env.local` for local development:
#
#     cp .env.example .env.local
#
# Every variable here is documented in blueprint §13.2 and docs/api/api-contract.md.
# Nothing needs to be set for the app to run: without configuration the interface
# reports "not connected" rather than failing or faking a response.
# =============================================================================


# -----------------------------------------------------------------------------
# PUBLIC — reach the browser bundle (VITE_ prefix)
# -----------------------------------------------------------------------------
# Safe to expose by construction, but still never commit real values. Only these
# two Supabase values are public; the service-role key is not and must not be
# prefixed with VITE_.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase **anon** public key. A service_role key here is a critical defect;
# src/config/env.ts detects that case and refuses to make requests.
VITE_SUPABASE_ANON_KEY=

# Absolute origin of the application API, used only by the Vite dev proxy.
# Leave empty in production: the browser calls /api/v1/* on its own origin.
# Example for local development: http://localhost:3000
VITE_API_ORIGIN=

# Optional build stamp surfaced in diagnostics.
VITE_APP_VERSION=0.1.0


# -----------------------------------------------------------------------------
# SERVER-ONLY — must never be prefixed with VITE_
# -----------------------------------------------------------------------------
# These belong to the Vercel server functions in api/ (blueprint §6). They are
# listed here so the boundary is explicit and so nobody "just adds" them to the
# browser bundle. The frontend does not read them and the build does not use them.
#
# SUPABASE_SERVICE_ROLE_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# TTS_PROVIDER_API_KEY=
# ASR_PROVIDER_API_KEY=
